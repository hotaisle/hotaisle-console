{
  "name": "hotaisle-console",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run --cwd web build",
    "dev": "bun run build && bun run --bun wrangler dev",
    "dev:fake": "bun run build && bun worker/dev/fake-api.mjs",
    "deploy": "bun run --bun wrangler deploy",
    "typecheck": "bun run --bun tsc -p worker && bun run --cwd web typecheck",
    "test": "bun run --bun vitest run",
    "test:ui": "bun run build && bun web/tests/stability.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.5.0",
    "@cloudflare/workers-types": "5.20261102.1",
    "typescript": "5.6.3",
    "vitest": "4.1.11",
    "wrangler": "4.156.2"
  },
  "cloudflare": {
    "bindings": {
      "SESSION_SECRET": {
        "description": "Encrypts sign-in sessions. 32 or more random characters: `openssl rand -base64 32`."
      }
    }
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "web"
  ]
}
