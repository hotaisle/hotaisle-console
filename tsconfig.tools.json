{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2022", "DOM"],
		"strict": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true
	},
	"include": [
		"test/**/*.ts",
		".github/scripts/*.ts",
		"vitest.config.ts",
		"worker/cloudflare.config.ts",
		"worker/scripts/*.ts",
		"worker/vite.config.ts",
		"worker/vitest.config.ts",
		"web/vite.config.ts",
		"web/vite.config.test.ts",
		"web/vitest.config.ts"
	]
}
