// hotaisle-console on Cloudflare Workers. `npm run dev` runs it locally; `npm run deploy` publishes it.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hotaisle-console",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // the backend's paths go to the Worker; everything else is served straight from the static files
    "run_worker_first": ["/auth/*", "/api/*", "/records/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "Account" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }],
  "vars": {
    "API_BASE": "https://admin.hotaisle.app/api"
  },
  // SESSION_SECRET is a secret, not a var: `npx wrangler secret put SESSION_SECRET` (32+ random characters).
  "observability": { "enabled": true }
}
